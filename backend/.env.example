# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/attendance_system

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Dynamic QR + WebAuthn (optional — falls back to JWT_ACCESS_SECRET)
# JWT_QR_SECRET=replace_with_another_long_random_string
# QR_TOKEN_EXPIRES_SECONDS=10

# Cookies
COOKIE_SECURE=false
